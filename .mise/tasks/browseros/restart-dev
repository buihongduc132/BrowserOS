#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
[[ -d "${REPO_ROOT}/packages/browseros-agent" ]] || REPO_ROOT="$(pwd)"
cd "$REPO_ROOT"

source "${REPO_ROOT}/scripts/launch/common.sh"

echo "=== browseros:restart-dev ==="
echo ""
echo "  ⚠  Data preservation: user profiles, LLM config, and extension"
echo "     storage are NEVER touched by this script."
echo ""

echo "[1/3] Killing existing dev instance..."
bash .mise/tasks/browseros/kill-dev

# Wait for ports to be released after kill (replaces fixed sleep)
echo "        Waiting for ports to release..."
for i in $(seq 1 20); do
  port_in_use "$DEV_CDP_PORT" || port_in_use "$DEV_SERVER_PORT" || break
  sleep 0.5
done

echo "[2/3] Building dev extension..."
if ! bash .mise/tasks/browseros/build-dev; then
  echo "" >&2
  echo "[ERROR] Build failed! Dev instance is stopped." >&2
  echo "        Fix the build error, then run:" >&2
  echo "          mise run browseros:start-dev" >&2
  exit 1
fi

echo "[3/3] Starting dev instance..."
bash .mise/tasks/browseros/start-dev

SERVER_LOG="/tmp/browseros-dev-server.log"
echo "[4/4] Running smoke test..."
if ! python3 "${REPO_ROOT}/scripts/verify/smoke-dev.py" "$DEV_SERVER_PORT"; then
  echo "" >&2
  echo "[ERROR] Smoke test FAILED! Dev server is up but endpoints are broken." >&2
  if [ -f "$SERVER_LOG" ]; then
    echo "" >&2
    echo "=== Server log (last 20 lines) ===" >&2
    tail -20 "$SERVER_LOG" >&2
  fi
  exit 1
fi

echo ""
echo "=== restart-dev complete ==="
