#!/usr/bin/env bash
set -euo pipefail
# start-prod — Launch BrowserOS prod instance (AppImage with embedded server)
# Prod uses the AppImage directly, not the Go CLI.
REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"

APPIMAGE="${BROWSEROS_APP_PATH:-$HOME/Downloads/alta/BrowserOS.AppImage}"
if [[ ! -f "$APPIMAGE" ]]; then
  echo "[ERROR] BrowserOS AppImage not found: $APPIMAGE" >&2
  echo "        Set BROWSEROS_APP_PATH or install to ~/Downloads/alta/" >&2
  exit 1
fi

# Kill existing prod instance
pkill -9 -f 'mount_Browse.*browseros' 2>/dev/null || true
sleep 2
rm -f ~/.config/browser-os/SingletonLock ~/.config/browser-os/SingletonCookie ~/.config/browser-os/SingletonSocket 2>/dev/null

exec "$APPIMAGE" --class=browseros
