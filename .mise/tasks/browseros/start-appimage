#!/usr/bin/env bash
set -euo pipefail
# start-appimage — Launch BrowserOS with embedded extensions + external dev server
# No build needed. Uses the AppImage's own extension. Fastest dev startup.
# Equivalent to: browseros-dev watch --appimage
# Dev ports from ../../../scripts/ports.sh: 9010/9011/9012

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/../../../scripts/ports.sh"

echo "[start-appimage] Dev ports: CDP=${DEV_CDP_PORT} Server=${DEV_SERVER_PORT} Extension=${DEV_EXTENSION_PORT}"
mise run browseros:dev -- watch --appimage
