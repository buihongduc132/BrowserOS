#!/usr/bin/env bash
set -uo pipefail
# status — Show BrowserOS instance status
# Uses ports from scripts/ports.sh — single source of truth.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/../../../scripts/ports.sh"

echo "=== Port Manifest (scripts/ports.sh) ==="
echo "  PROD:  CDP=$PROD_CDP_PORT  Server=$PROD_SERVER_PORT  Extension=$PROD_EXTENSION_PORT"
echo "  DEV:   CDP=$DEV_CDP_PORT  Server=$DEV_SERVER_PORT  Extension=$DEV_EXTENSION_PORT"

echo ""
echo "=== PROD Ports ==="
for port_name in "CDP:$PROD_CDP_PORT" "Server:$PROD_SERVER_PORT" "Extension:$PROD_EXTENSION_PORT"; do
  label="${port_name%%:*}"
  port="${port_name##*:}"
  if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
    echo "  $label :$port — IN USE"
  else
    echo "  $label :$port — free"
  fi
done

echo ""
echo "=== DEV Ports ==="
for port_name in "CDP:$DEV_CDP_PORT" "Server:$DEV_SERVER_PORT" "Extension:$DEV_EXTENSION_PORT"; do
  label="${port_name%%:*}"
  port="${port_name##*:}"
  if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
    echo "  $label :$port — IN USE"
  else
    echo "  $label :$port — free"
  fi
done

echo ""
echo "=== PROD Health ==="
prod_health=$(curl -sf "http://localhost:$PROD_SERVER_PORT/health" 2>/dev/null || echo "")
if [ -n "$prod_health" ]; then
  echo "  $prod_health"
else
  echo "  Not running"
fi

echo ""
echo "=== DEV Health ==="
dev_health=$(curl -sf "http://localhost:$DEV_SERVER_PORT/health" 2>/dev/null || echo "")
if [ -n "$dev_health" ]; then
  echo "  $dev_health"
else
  echo "  Not running"
fi

echo ""
echo "=== Running BrowserOS processes ==="
ps aux | grep -E 'BrowserOS|browseros-dev|browseros_server' | grep -v grep | wc -l
echo "  processes total"
