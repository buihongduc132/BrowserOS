#!/usr/bin/env bash
set -euo pipefail
# status — Show BrowserOS instance status
echo "=== BrowserOS Processes ==="
ps aux | grep -E 'BrowserOS|browseros-dev' | grep -v grep | head -10 || echo "  None running"
echo ""
echo "=== Prod Ports (9000/9100/9300) ==="
for port in 9000 9100 9300; do
  if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
    echo "  :${port} — IN USE (prod)"
  else
    echo "  :${port} — free"
  fi
done
echo ""
echo "=== Dev Ports (9010/9110/9310) ==="
for port in 9010 9110 9310; do
  if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
    echo "  :${port} — IN USE (dev)"
  else
    echo "  :${port} — free"
  fi
done
