#!/usr/bin/env bash
set -euo pipefail
# status — Show BrowserOS dev instance status
# Check if any BrowserOS processes are running
echo "=== BrowserOS Processes ==="
ps aux | grep -E 'BrowserOS|browseros-dev' | grep -v grep | head -10 || echo "  None running"
echo ""
echo "=== Ports ==="
for port in 9000 9010 9100 9110 9300 9305; do
  if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
    echo "  :${port} — IN USE"
  fi
done
