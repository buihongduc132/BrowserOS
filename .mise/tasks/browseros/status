#!/usr/bin/env bash
set -euo pipefail
# status — Show BrowserOS dev instance status
# Delegates to instance.sh print_status.
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
[[ -d "${REPO_ROOT}/packages/browseros-agent" ]] || REPO_ROOT="$(pwd)"

source "${REPO_ROOT}/scripts/launch/common.sh"
source "${REPO_ROOT}/scripts/launch/instance.sh"
declare_instance dev

print_status
