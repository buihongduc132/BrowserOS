#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
[[ -d "${REPO_ROOT}/packages/browseros-agent" ]] || REPO_ROOT="$(pwd)"
cd "${REPO_ROOT}/packages/browseros-agent"
# Build extension WITHOUT --mode development (HMR-free)
# The old build:agent:dev used --mode development which injected
# vite-hmr client code connecting to ws://localhost:3001.
# That only works when the WXT dev server is running alongside the browser.
# For mise start-dev we load the extension statically,
# so we need a production build outputting to chrome-mv3-dev.
cd "${REPO_ROOT}/packages/browseros-agent/apps/agent"
rm -rf dist/chrome-mv3-dev
# Load .env.development vars so VITE_PUBLIC_BROWSEROS_API resolves correctly.
# Without this, auth.content matches[] becomes "undefined/home" (invalid manifest).
# --mode production is the WXT default but it only loads .env.production.
# --mode development loads .env.development (which has the API URL).
# We use --mode development for env loading but the build is still production-quality
# (no HMR) because we don't pass --dev.
bun wxt build --mode development
mv dist/chrome-mv3 dist/chrome-mv3-dev
