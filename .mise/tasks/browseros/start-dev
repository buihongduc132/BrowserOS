#!/usr/bin/env bash
set -euo pipefail
# mise executes this from the project root (where .mise.toml lives)
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
[[ -d "${REPO_ROOT}/packages/browseros-agent" ]] || REPO_ROOT="$(pwd)"
cd "${REPO_ROOT}/packages/browseros-agent"

source "${REPO_ROOT}/scripts/launch/common.sh"

APP="${BROWSEROS_APP_PATH:-$HOME/Downloads/alta/BrowserOS.AppImage}"
EXT_DIR="$(cd 'apps/agent/dist/chrome-mv3-dev' 2>/dev/null && pwd)"
BROWSER_LOG="${DEV_BOS_DIR}/browser.log"
SERVER_LOG="${DEV_BOS_DIR}/server.log"

# ── Fallback cleanup on ANY failure (fixes H2) ──
cleanup_on_failure() {
  echo "[cleanup] start-dev failed — cleaning up orphaned processes..." >&2
  bash "${REPO_ROOT}/.mise/tasks/browseros/kill-dev" 2>/dev/null || true
}
trap cleanup_on_failure ERR

# ── Ensure state dirs exist (mkdir only, NEVER rm) ──
mkdir -p "$DEV_PROFILE" "$DEV_BOS_DIR"

# ── Singleton guard with flock (fixes H3) ──
LOCK_FD=200
eval "exec $LOCK_FD>\"${DEV_BOS_DIR}/start.lock\""
flock -n $LOCK_FD || {
  echo "[ERROR] Another start-dev is already running (lock held)." >&2
  echo "        If stale, remove ${DEV_BOS_DIR}/start.lock" >&2
  exit 1
}

# ── Check if browser already running via PID file (fixes M1) ──
if is_browser_running "$DEV_BROWSER_PID"; then
  OLD_PID=$(cat "$DEV_BROWSER_PID")
  echo "[ERROR] Dev browser already running (PID $OLD_PID)." >&2
  echo "        Run 'mise run browseros:kill-dev' first." >&2
  exit 1
fi

# ── Pre-flight: check BOTH ports (fixes H1) ──
if port_in_use "$DEV_CDP_PORT"; then
  echo "[ERROR] CDP port $DEV_CDP_PORT already in use — dev instance may be running." >&2
  echo "        Run 'mise run browseros:kill-dev' first." >&2
  exit 1
fi
if port_in_use "$DEV_SERVER_PORT"; then
  echo "[ERROR] Server port $DEV_SERVER_PORT already in use." >&2
  echo "        Run 'mise run browseros:kill-dev' first." >&2
  exit 1
fi

# ── Pre-flight: check binary and extension ──
command -v python3 >/dev/null || { echo "[ERROR] python3 required but not in PATH" >&2; exit 1; }
command -v bun >/dev/null || { echo "[ERROR] bun required but not in PATH" >&2; exit 1; }
if [ ! -x "$APP" ]; then
  echo "[ERROR] BrowserOS AppImage missing: $APP" >&2
  echo "        Set BROWSEROS_APP_PATH env var to override." >&2
  exit 1
fi
if [ ! -d "$EXT_DIR" ]; then
  echo "[ERROR] Dev extension build missing: $EXT_DIR" >&2
  exit 1
fi

# ── Desktop entries: only install if missing (prevents GNOME losing window tracking) ──
if [ ! -f "${HOME}/.local/share/applications/browseros-dev.desktop" ]; then
  "$REPO_ROOT/scripts/setup-desktop-entries.sh" 2>/dev/null || true
fi

# ── Clean stale singleton locks ──
clean_singleton_locks "$DEV_PROFILE"

# ── Rotate previous logs (keep .prev for crash debugging) ──
[ -f "$BROWSER_LOG" ] && mv -f "$BROWSER_LOG" "${BROWSER_LOG}.prev"
[ -f "$SERVER_LOG" ] && mv -f "$SERVER_LOG" "${SERVER_LOG}.prev"

# ── Start dev browser ──
echo "[start] Launching BrowserOS Dev (CDP=$DEV_CDP_PORT, Server=$DEV_SERVER_PORT)..."
nohup "$APP" \
  --no-sandbox \
  --no-first-run \
  --no-default-browser-check \
  --use-mock-keychain \
  --show-component-extension-options \
  --disable-browseros-server \
  --disable-browseros-extensions \
  --name=BrowserOS-Dev \
  --class=browseros-dev \
  --remote-debugging-port="$DEV_CDP_PORT" \
  --browseros-mcp-port="$DEV_SERVER_PORT" \
  --browseros-server-port="$DEV_SERVER_PORT" \
  --user-data-dir="$DEV_PROFILE" \
  --load-extension="$EXT_DIR" \
  chrome://newtab \
  > "$BROWSER_LOG" 2>&1 &
BROWSER_PID=$!
echo "$BROWSER_PID" > "$DEV_BROWSER_PID"

# ── Wait for CDP port — pass port as CLI arg (fixes M4) ──
python3 - "$DEV_CDP_PORT" <<"PY"
import socket, time, sys, os
port = int(sys.argv[1])
for i in range(60):
    s = socket.socket()
    s.settimeout(0.5)
    try:
        s.connect(("127.0.0.1", port))
        s.close()
        sys.exit(0)
    except OSError:
        if i % 10 == 0:
            sys.stderr.write(f"  waiting for CDP port {port}... ({i}/60)\n")
            sys.stderr.flush()
        time.sleep(0.5)
print(f"[ERROR] BrowserOS CDP port {port} did not open", file=sys.stderr)
if os.path.exists("/home/bhd/.browseros-dev/browser.log"):
    os.system("tail -20 /home/bhd/.browseros-dev/browser.log >&2")
sys.exit(1)
PY
echo "[start] Browser ready on CDP port $DEV_CDP_PORT"

# ── Start dev server ──
echo "[start] Launching dev server..."
nohup env \
  BROWSEROS_SKIP_OPENCLAW=1 \
  BROWSEROS_CDP_PORT="$DEV_CDP_PORT" \
  BROWSEROS_SERVER_PORT="$DEV_SERVER_PORT" \
  BROWSEROS_EXTENSION_PORT="$DEV_EXTENSION_PORT" \
  bun run --filter @browseros/server start:ci \
  > "$SERVER_LOG" 2>&1 &
SERVER_PID=$!
echo "$SERVER_PID" > "$DEV_SERVER_PID"

# ── Wait for server health — pass port as CLI arg (fixes M4) ──
python3 - "$DEV_SERVER_PORT" <<"PY"
import json, time, urllib.request, sys, os
port = sys.argv[1]
url = f"http://127.0.0.1:{port}/health"
for i in range(60):
    try:
        with urllib.request.urlopen(url, timeout=1) as r:
            data = json.load(r)
        if data.get("status") == "ok" and data.get("cdpConnected") is True:
            print(json.dumps(data))
            sys.exit(0)
        if i % 10 == 0:
            sys.stderr.write(f"  waiting for server health... ({i}/60)\n")
            sys.stderr.flush()
        time.sleep(1)
    except Exception:
        if i % 10 == 0:
            sys.stderr.write(f"  waiting for server... ({i}/60)\n")
            sys.stderr.flush()
        time.sleep(0.5)
print(f"[ERROR] BrowserOS server health check failed on {url}", file=sys.stderr)
if os.path.exists("/home/bhd/.browseros-dev/server.log"):
    os.system("tail -20 /home/bhd/.browseros-dev/server.log >&2")
sys.exit(1)
PY
echo "[start] Server ready on port $DEV_SERVER_PORT"
echo "=== start-dev complete ==="

# Release lock on success
flock -u $LOCK_FD
