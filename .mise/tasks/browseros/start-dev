#!/usr/bin/env bash
set -euo pipefail
# start-dev — Launch BrowserOS dev instance (browser + server)
# Delegates to instance.sh for all shared logic.
# mise dependency: browseros:build-dev (defined in .mise.toml)
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
[[ -d "${REPO_ROOT}/packages/browseros-agent" ]] || REPO_ROOT="$(pwd)"

source "${REPO_ROOT}/scripts/launch/common.sh"
source "${REPO_ROOT}/scripts/launch/instance.sh"
declare_instance dev

# ── Fallback cleanup on failure ──
cleanup_on_failure() {
  echo "[cleanup] start-dev failed — cleaning up orphaned processes..." >&2
  kill_instance
  if [ -f "$INSTANCE_SERVER_LOG" ]; then
    echo "" >&2
    echo "=== Server log (last 20 lines) ===" >&2
    tail -20 "$INSTANCE_SERVER_LOG" >&2
  fi
}
trap cleanup_on_failure ERR

# ── Pre-flight checks (dirs, singleton, ports) ──
preflight_checks

# ── Ensure desktop entries exist ──
ensure_desktop_entries

# ── Check extension build ──
ext_dir="${REPO_ROOT}/packages/browseros-agent/${INSTANCE_EXT_DIR}"
if [ ! -d "$ext_dir" ]; then
  echo "[ERROR] Dev extension build missing: $ext_dir" >&2
  echo "        Run: mise run browseros:build-dev" >&2
  exit 1
fi

# ── Launch browser ──
launch_browser

# ── Wait for CDP port ──
wait_cdp 30

# ── Trigger extension loading (CDP tab creation bypasses profile picker gate) ──
trigger_extensions

# ── Start dev server ──
start_dev_server

# ── Wait for server health ──
wait_server_health 30 basic

# ── Release lock on success ──
release_lock

echo "=== start-dev complete ==="
