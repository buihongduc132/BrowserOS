#!/usr/bin/env bash
set -euo pipefail
# kill-prod — Stop BrowserOS PROD instance only
# GUARD: Refuses to kill if prod is actively serving (health=ok / cdpConnected=true)
# Override: BROWSEROS_FORCE_KILL_PROD=1 mise run browseros:kill-prod
#
# Detection: PROD is identified by its fixed ports (9105/9200/9300), NOT by
# --user-data-dir flag (AppImage doesn't pass it as a CLI arg).

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/../../../scripts/ports.sh"

PROD_PROFILE="$HOME/.config/browser-os"

# ── Check if PROD is running (by port occupancy) ──────────────────────
prod_running=false
for port in "$PROD_SERVER_PORT" "$PROD_CDP_PORT"; do
  if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
    prod_running=true
    break
  fi
done

if $prod_running; then
  # ── Guard: check health endpoint ────────────────────────────────────
  force="${BROWSEROS_FORCE_KILL_PROD:-}"

  if [[ "$force" != "1" ]]; then
    health_response=""
    health_response=$(curl -sf --max-time 3 "http://localhost:${PROD_SERVER_PORT}/health" 2>/dev/null) || true

    if [[ -n "$health_response" ]]; then
      status_ok=false
      cdp_connected=false

      if echo "$health_response" | grep -q '"status":"ok"'; then
        status_ok=true
      fi
      if echo "$health_response" | grep -q '"cdpConnected":true'; then
        cdp_connected=true
      fi

      if $status_ok || $cdp_connected; then
        echo "" >&2
        echo "╔══════════════════════════════════════════════════════════╗" >&2
        echo "║  ⛔ PROD is ACTIVE — browser is connected.              ║" >&2
        echo "║  Killing it would disrupt active user sessions.         ║" >&2
        echo "║                                                          ║" >&2
        echo "║  If you REALLY need to force kill:                       ║" >&2
        echo "║  BROWSEROS_FORCE_KILL_PROD=1 mise run browseros:kill-prod ║" >&2
        echo "╚══════════════════════════════════════════════════════════╝" >&2
        echo "" >&2
        exit 1
      fi
    fi
    # Health unreachable or not ok → prod not active, proceed with kill
  else
    echo "[kill-prod] ⚠️  FORCE KILL requested — bypassing safety guard" >&2
  fi

  # ── Kill by PROD ports using fuser ──────────────────────────────────
  killed=0

  for port in "$PROD_CDP_PORT" "$PROD_SERVER_PORT" "$PROD_EXTENSION_PORT"; do
    if fuser -k "${port}/tcp" 2>/dev/null; then
      killed=$((killed+1))
    fi
  done

  # Also kill the AppImage wrapper and crashpad handlers
  for pid in $(ps aux 2>/dev/null | grep -v grep | grep 'browser-os/Crash\|BrowserOS.AppImage' | grep -v 'browseros-dev' | awk '{print $2}'); do
    kill "$pid" 2>/dev/null && killed=$((killed+1)) || true
  done

  sleep 1

  # Clean singleton locks for prod profile only
  rm -f "$PROD_PROFILE/SingletonLock" "$PROD_PROFILE/SingletonCookie" "$PROD_PROFILE/SingletonSocket" 2>/dev/null

  echo "[kill-prod] Stopped $killed prod process(es)"
else
  echo "[kill-prod] No prod instance found (ports $PROD_SERVER_PORT/$PROD_CDP_PORT not in use)"
fi
