# Ports (prod: 9000/9100/9300, dev: 9010/9110/9310)
# Dev uses offset ports so dev + prod can run side-by-side.
BROWSEROS_CDP_PORT=9010
BROWSEROS_SERVER_PORT=9110
BROWSEROS_EXTENSION_PORT=9310

# Legacy dev port overrides (no longer needed — ports above are already offset)
# BROWSEROS_DEV_CDP_PORT=9010
# BROWSEROS_DEV_SERVER_PORT=9110
# BROWSEROS_DEV_EXTENSION_PORT=9310

# Directories (optional - defaults to cwd)
# BROWSEROS_RESOURCES_DIR=./resources
# BROWSEROS_EXECUTION_DIR=./out

# BrowserOS config
BROWSEROS_CONFIG_URL=https://llm.browseros.com/api/browseros-server/config
BROWSEROS_VERSION=
BROWSEROS_INSTALL_ID=
BROWSEROS_CLIENT_ID=

BROWSEROS_TRUSTED_ORIGINS=

# Graph service
CODEGEN_SERVICE_URL=

# Telemetry
POSTHOG_API_KEY=
SENTRY_DSN=

NODE_ENV=development
LOG_LEVEL=info

# Debug — captures every LLM call to .devtools/generations.json (view with `npx @ai-sdk/devtools`)
# BROWSEROS_AI_SDK_DEVTOOLS=true

# Testing
BROWSEROS_TEST_HEADLESS=false
