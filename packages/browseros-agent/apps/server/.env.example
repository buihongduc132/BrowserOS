# Ports (prod defaults: 9000/9100, dev defaults: 9010/9110)
BROWSEROS_CDP_PORT=9000
BROWSEROS_SERVER_PORT=9100
BROWSEROS_EXTENSION_PORT=9300

# Dev port overrides (used by mise tasks, sourced from common.sh)
# These use separate env vars to avoid collision when dev + prod run side-by-side.
# BROWSEROS_DEV_CDP_PORT=9010
# BROWSEROS_DEV_SERVER_PORT=9110
# BROWSEROS_DEV_EXTENSION_PORT=9305

# Directories (optional - defaults to cwd)
# BROWSEROS_RESOURCES_DIR=./resources
# BROWSEROS_EXECUTION_DIR=./out

# BrowserOS config
BROWSEROS_CONFIG_URL=https://llm.browseros.com/api/browseros-server/config
BROWSEROS_VERSION=
BROWSEROS_INSTALL_ID=
BROWSEROS_CLIENT_ID=

BROWSEROS_TRUSTED_ORIGINS=

# Graph service
CODEGEN_SERVICE_URL=

# Telemetry
POSTHOG_API_KEY=
SENTRY_DSN=

NODE_ENV=development
LOG_LEVEL=info

# Debug — captures every LLM call to .devtools/generations.json (view with `npx @ai-sdk/devtools`)
# BROWSEROS_AI_SDK_DEVTOOLS=true

# Testing
BROWSEROS_TEST_HEADLESS=false
